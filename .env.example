# ── NextCloud ─────────────────────────────────────────────────────────────────
# URL base de tu instancia NextCloud (sin barra al final)
NEXTCLOUD_URL=https://tu-nextcloud.example.com

# Usuario de NextCloud
NEXTCLOUD_USERNAME=tu-usuario

# App Token: NextCloud → Configuración → Seguridad → Contraseñas de aplicación
NEXTCLOUD_APP_TOKEN=xxxx-xxxx-xxxx-xxxx-xxxx

# Carpeta donde se guardarán las fotos (se crea automáticamente)
NEXTCLOUD_FOLDER=fotos-boda

# ── App ───────────────────────────────────────────────────────────────────────
# URL pública de la app (para el código QR)
APP_URL=http://localhost:3000

# Nombres de los novios (se muestra en el hero)
COUPLE_NAMES=Ana & Carlos

# Fecha de la boda (texto libre)
WEDDING_DATE=20 de Junio, 2026
